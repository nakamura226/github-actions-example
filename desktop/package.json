{
  "name": "example-desktop",
  "productName": "Example",
  "version": "2.7.19",
  "description": "My Electron application description",
  "private": true,
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:mac": "electron-forge package --platform=darwin --arch=x64",
    "package:mac:zip": "zip -r out/$npm_package_productName-darwin-x64-${NODE_ENV}.zip out/$npm_package_productName-darwin-x64",
    "package:win": "electron-forge package --platform=win32 --arch=x64",
    "package:win:zip": "zip -r out/$npm_package_productName-win32-x64-${NODE_ENV}.zip out/$npm_package_productName-win32-x64",
    "package:linux": "electron-forge package --platform=linux --arch=x64",
    "package:linux:zip": "zip -r out/$npm_package_productName-linux-x64-${NODE_ENV}.zip out/$npm_package_productName-linux-x64",
    "package:all:prod": "dotenv -e .env.production yarn package:mac && NODE_ENV=production yarn package:mac:zip && dotenv -e .env.production yarn package:win && NODE_ENV=production yarn package:win:zip",
    "package:all:stage": "dotenv -e .env.staging yarn package:mac && NODE_ENV=staging yarn package:mac:zip && dotenv -e .env.staging yarn package:win && NODE_ENV=staging yarn package:win:zip",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "make:mac": "electron-forge make --platform=darwin --arch=x64",
    "make:linux": "electron-forge make --platform=linux --arch=x64",
    "installer:win": "electron-installer-windows --src out/$npm_package_productName-win32-x64 --dest out/installers",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "underground",
    "email": "nacanori@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^6.0.4",
    "@electron-forge/maker-deb": "^6.0.4",
    "@electron-forge/maker-rpm": "^6.0.4",
    "@electron-forge/maker-squirrel": "^6.0.4",
    "@electron-forge/maker-zip": "^6.0.4",
    "@electron-forge/plugin-webpack": "^6.0.4",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/dotenv-webpack": "^7.0.3",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "css-loader": "^6.0.0",
    "dotenv-cli": "^6.0.0",
    "electron": "22.0.0",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "fork-ts-checker-webpack-plugin": "^7.2.13",
    "node-loader": "^2.0.0",
    "semantic-release": "^19.0.5",
    "style-loader": "^3.0.0",
    "ts-loader": "^9.2.2",
    "ts-node": "^10.0.0",
    "typescript": "~4.5.4"
  },
  "dependencies": {
    "electron-log": "^4.4.8",
    "electron-squirrel-startup": "^1.0.0"
  }
}
